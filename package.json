{
  "name": "ppt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir ../artifacts",
    "preview": "npm run build && wrangler dev",
    "build:slides": "rm -rf ./dist-slides && node scripts/build-slides.js",
    "build:export-pptx": "node ../.codebuddy/skills/ppt-implement/scripts/export/html2pptx.js ./dist-slides/all-slides.html ../artifacts/presentation.pptx && rm -rf ./dist-slides",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "juice": "^11.1.0",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "vite": "^7.2.2",
    "wrangler": "^4.100.0"
  }
}
